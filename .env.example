# Roleprint environment template.
#
# Local development:
#   copy this file to backend/.env (the API reads it from its working directory)
#   copy the VITE_API_URL line into frontend/.env.local
#
# Docker Compose:
#   copy this file to .env at the repository root and set JWT_SECRET and
#   POSTGRES_PASSWORD. Never reuse the placeholder values in production.

# ---------------------------------------------------------------------------
# Core application
# ---------------------------------------------------------------------------
APP_NAME=Roleprint API
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# Comma-separated list of browser origins allowed to call the API directly.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Local default. Docker Compose overrides this with a PostgreSQL URL.
DATABASE_URL=sqlite:///./roleprint.db
# Development convenience. Set to false in production and run Alembic.
AUTO_CREATE_TABLES=true

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14

# ---------------------------------------------------------------------------
# Upload and request limits
# ---------------------------------------------------------------------------
MAX_UPLOAD_BYTES=10485760
MAX_PDF_PAGES=60
MAX_RESUME_CHARS=200000
MAX_JOB_CHARS=100000
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
ENABLE_RATE_LIMIT=true

# ---------------------------------------------------------------------------
# Optional AI features (all disabled by default; the app works without them)
# ---------------------------------------------------------------------------
# Local sentence-transformers similarity. The model is never downloaded
# implicitly; install requirements-nlp.txt and provision the model yourself.
ENABLE_SEMANTIC_MATCHING=true

# OpenAI rewriting requires BOTH the key and ENABLE_OPENAI_REWRITER=true, and
# each request must still opt in unless OPENAI_CONSENT_DEFAULT=true.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ENABLE_OPENAI_REWRITER=false
OPENAI_CONSENT_DEFAULT=false

# OCR requires pytesseract plus the Tesseract binary on the host.
ENABLE_OCR=false

# ---------------------------------------------------------------------------
# Frontend (Vite)
# ---------------------------------------------------------------------------
# Direct API origin for local development. The Docker build uses /api instead.
VITE_API_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# Docker Compose only
# ---------------------------------------------------------------------------
POSTGRES_PASSWORD=change-this-postgres-password
# Reuse the same strong value as JWT_SECRET above when composing.
